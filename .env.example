POSTGRES_DB=cortex
POSTGRES_USER=cortex
POSTGRES_PASSWORD=
# Sign-in: OAuth client IDs (comma-separated). Google: web client ID. Apple: Services ID (web) and bundle ID (iOS).
CORTEX_GOOGLE_CLIENT_IDS=
CORTEX_APPLE_CLIENT_IDS=
# Owner IDs allowed to review knowledge, e.g. google:1234567890
CORTEX_ADMIN_OWNER_IDS=
AI_SERVICE_URL=http://cortex-ai:8000
S3_ENDPOINT=objectstore:9000
S3_PUBLIC_ENDPOINT=localhost:9000
S3_BUCKET=cortex-private
S3_ACCESS_KEY=
S3_SECRET_KEY=
CORTEX_INFERENCE=1
CORTEX_INFERENCE_ENABLED=false
CORTEX_MODEL_ID=
POSTGRES_PORT=5433
# Generate with: openssl rand -hex 32 (signs short-lived MCP tokens)
# Secrets below are generated by scripts/bootstrap-env; never commit real values.
CORTEX_MCP_SIGNING_KEY=
# Local LLM runtime on the host; leave the model empty to show recorded facts only.
CORTEX_OLLAMA_URL=http://host.docker.internal:11434
CORTEX_OLLAMA_MODEL=
# Hugging Face embeddings (pinned and baked into the cortex-ai image).
# The vector column is 384-dimensional; choose a model with the same output size or add a migration.
CORTEX_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
CORTEX_EMBEDDING_REVISION=5c38ec7c405ec4b44b94cc5a9bb96e735b38267a
CORTEX_EMBEDDING_REQUIRED=true
# Optional cross-encoder reranker; set both and CORTEX_RERANK_ENABLED=true to enable.
CORTEX_RERANKER_MODEL=
CORTEX_RERANKER_REVISION=
CORTEX_RERANK_ENABLED=false

# Comma-separated owner IDs allowed to review research-agent proposals (development mode allows the local operator).
CORTEX_ADMIN_OWNER_IDS=
